{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@tarojs/components": ["src/types/taro-components.d.ts"]
    },
    "types": ["node", "@tarojs/taro", "@tarojs/components"]
  },
  "include": ["src", "config"]
}
